# Aplicación
HERMES_ENTORNO=desarrollo
HERMES_HOST_API=127.0.0.1
HERMES_PUERTO_API=8000
HERMES_NIVEL_LOG=INFO
HERMES_MAX_INTENTOS_AUTENTICACION=10
HERMES_VENTANA_AUTENTICACION_SEGUNDOS=60

# MariaDB local de Hermes
PUERTO_PUBLICADO_BASE_DATOS=3378
HERMES_HOST_BASE_DATOS=127.0.0.1
HERMES_PUERTO_BASE_DATOS=3378
HERMES_NOMBRE_BASE_DATOS=hermes
HERMES_USUARIO_BASE_DATOS=hermes
HERMES_CONTRASENA_BASE_DATOS=cambie_esta_contrasena_local
HERMES_CONTRASENA_RAIZ_BASE_DATOS=cambie_esta_contrasena_raiz_local
HERMES_TIEMPO_ESPERA_BASE_DATOS_SEGUNDOS=5

# Transporte SSH: las rutas contienen material local ignorado por Git
HERMES_DIRECTORIO_CREDENCIALES_SSH=.secretos/claves_ssh
HERMES_ARCHIVO_HOSTS_CONOCIDOS_SSH=.secretos/hosts_conocidos
HERMES_TIEMPO_CONEXION_SSH_SEGUNDOS=10
HERMES_TIEMPO_AUTENTICACION_SSH_SEGUNDOS=10
HERMES_TIEMPO_OPERACION_SSH_SEGUNDOS=15
HERMES_LIMITE_SALIDA_SSH_BYTES=65536
HERMES_LIMITE_ARCHIVO_TRANSFERENCIA_BYTES=8388608
HERMES_TAMANO_BLOQUE_TRANSFERENCIA_BYTES=65536
HERMES_INTERVALO_MANTENIMIENTO_SSH_SEGUNDOS=15
HERMES_MAX_INTENTOS_MANTENIMIENTO_SSH=3

# Operaciones sobre varios servidores: límites por solicitud, no por inventario
HERMES_MAX_CONCURRENCIA_ACCIONES_MULTIPLES=4
HERMES_MAX_SERVIDORES_ACCION_MULTIPLE=100
HERMES_TIEMPO_LIMITE_ACCION_MULTIPLE_SEGUNDOS=45

# Telegram: el token real solo debe existir en .env y nunca en Git
HERMES_TELEGRAM_HABILITADO=false
HERMES_TOKEN_TELEGRAM=reemplace_con_el_token_entregado_por_botfather
HERMES_ID_PROPIETARIO_TELEGRAM=
HERMES_TIEMPO_CONFIRMACION_TELEGRAM_SEGUNDOS=60
HERMES_MAX_SERVIDORES_MOSTRADOS_TELEGRAM=50

# Slack mediante Socket Mode: los valores reales nunca deben entrar en Git
HERMES_SLACK_HABILITADO=false
HERMES_TOKEN_BOT_SLACK=xoxb-reemplace_con_el_token_del_bot
HERMES_TOKEN_APLICACION_SLACK=xapp-reemplace_con_el_token_de_aplicacion
HERMES_TIEMPO_CONFIRMACION_SLACK_SEGUNDOS=60
HERMES_MAX_SERVIDORES_MOSTRADOS_SLACK=50

# Monitor automático: se ejecuta como proceso local independiente
HERMES_MONITOREO_HABILITADO=false
HERMES_INTERVALO_MONITOREO_SEGUNDOS=60
HERMES_MAX_CONCURRENCIA_MONITOREO=4
HERMES_TIEMPO_LIMITE_SONDEO_SEGUNDOS=45
HERMES_MAX_INTENTOS_NOTIFICACION_ALERTA=3

# Tareas programadas: proceso independiente respaldado por MariaDB
HERMES_TAREAS_HABILITADAS=false
HERMES_INTERVALO_REVISION_TAREAS_SEGUNDOS=15
HERMES_DURACION_BLOQUEO_TAREA_SEGUNDOS=600
HERMES_MAX_TAREAS_POR_CICLO=20
HERMES_MAX_CONCURRENCIA_TAREAS=2
HERMES_MAX_INTENTOS_NOTIFICACION_TAREA=3
